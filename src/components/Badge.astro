---
import "../styles/components/_badge.scss";
interface Props {
  text: string;
  variant?: "dark" | "light";
  class?: string;
}

const { text, variant = "dark", class: className, ...rest } = Astro.props;

const classes = ["badge", `badge--${variant}`, className].filter(Boolean);
---

<div class:list={classes} {...rest}>
  <span class="badge__text type-body-sm-2">{text}</span>
</div>
