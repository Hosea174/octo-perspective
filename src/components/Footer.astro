---
import { Image } from "astro:assets";

import "../styles/components/footer.scss";

// assets
import ftrLogo from "../assets/footer-logo.svg";
---

<footer>
  <div class="wrapper">
    <Image src={ftrLogo} alt="Logo" />

    <div class="container">
      <div class="ftr-nav">
        <div class="ftr-left">
          <a class="ftr-logo" href="/">
            <Image src={ftrLogo} alt="Logo" />
          </a>
          <div class="ftr-menu">
            <a href="/">Home</a>
            <a href="/">About</a>
            <a href="/">Contact</a>
            <a href="/">Services</a>
            <a href="/">Portfolio</a>
          </div>
        </div>

        <div class="ftr-right">
          <div class="ftr-socials">
            <a href="/">TikTok</a>
            <a href="/">Instagram</a>
            <a href="/">FaceBook</a>
            <a href="/">Dribbble</a>
            <a href="/">Behance</a>
          </div>
          <p class="copyright">
            © 2025 Ecliptic Creative, All Rights Reserved.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
