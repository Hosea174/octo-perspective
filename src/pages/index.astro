---
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";

import "../styles/pages/index.scss";
---

<Layout title="Astro Starter" description="A lightweight Astro starter template.">
  <Header />

  <main class="home-page">
    <section class="home-hero container">
      <p class="home-hero__eyebrow" data-fade-in="st">Astro Starter</p>
      <h1 class="home-hero__title" data-text-anim="headerAnimation">
        Start clean, then design the project.
      </h1>
      <p class="home-hero__copy" data-fade-in="st:fade-subtle">
        Replace this page with the real project content. The starter keeps only the reusable shell, motion hooks, and component examples.
      </p>
      <div class="home-hero__actions" data-fade-in="st">
        <Button text="Primary action" href="/about" />
        <Button text="Ghost action" href="#example" variant="ghost" />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
