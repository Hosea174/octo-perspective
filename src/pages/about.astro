---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";

import "../styles/pages/about.scss";
---

<Layout title="About" description="A small placeholder page for the static starter.">
  <Header />

  <main class="about-page">
    <section class="about-section container">
      <p class="about-section__eyebrow" data-fade-in="st">Example Page</p>
      <h1 class="about-section__title" data-text-anim="headerAnimation">About this starter</h1>
      <p class="about-section__copy" data-fade-in="st:fade-subtle">
        Keep or remove this page depending on the project. It exists only to show routing and shared layout structure.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
